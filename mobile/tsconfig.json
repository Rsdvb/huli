{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "virtual:kettu-page-runtime": ["./src/artifact-view/page-runtime.generated.ts"],
      "@noble/*": ["./node_modules/@noble/*"],
      "i18next": ["./node_modules/i18next"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
