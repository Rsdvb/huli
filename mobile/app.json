{
  "expo": {
    "name": "Huli",
    "slug": "huli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "huli",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rsdvb.huli",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Huli 通过局域网或 Tailscale 连接你电脑上的 Huli。"
      }
    },
    "android": {
      "package": "com.rsdvb.huli",
      "adaptiveIcon": {
        "backgroundColor": "#E2611F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Huli 用相机扫描电脑上显示的配对二维码。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-router"
    ]
  }
}
