{
  "expo": {
    "name": "Huli",
    "slug": "huli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "huli",
    "ios": {
      "icon": "./assets/kite.icon",
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "io.github.rsdvb.huli",
      "appleTeamId": "Z5C6TTY2YF",
      "entitlements": {
        "com.apple.security.application-groups": ["group.io.github.rsdvb.huli"]
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocalNetworkUsageDescription": "纸鸢通过局域网或 Tailscale 连接你电脑上的纸鸢。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.rsdvb.huli",
      "adaptiveIcon": {
        "backgroundColor": "#F07A3E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "plugins": [
      "./plugins/withAppName",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "纸鸢用相机扫描电脑上显示的配对二维码，也用来拍照发给电脑上的智能体。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "纸鸢从相册选你挑的图片，发给电脑上的智能体。",
          "cameraPermission": "纸鸢用相机扫描电脑上显示的配对二维码，也用来拍照发给电脑上的智能体。",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-local-authentication",
        { "faceIDPermission": "纸鸢用面容 ID 在你回到 App 时解锁，不让别人看到你的会话。" }
      ],
      ["expo-notifications", { "enableBackgroundRemoteNotifications": true }],
      "./plugins/withNotificationService",
      "./plugins/withWidgets",
      "./plugins/withSystem",
      "./plugins/withShareExtension",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*", "*/*"],
          "androidMultiIntentFilters": ["*/*"]
        }
      ],
      "expo-image"
    ]
  }
}
