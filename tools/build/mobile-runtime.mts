// Writes the artifact page runtime into the phone app as one script, which Metro gives its code as
// the module `virtual:kettu-page-runtime`, as the Vite plugin in page-runtime.ts does for the
// desktop and the daemon. Metro cannot bundle a second entry on its own, so the script is built
// here and committed: run `node tools/build/mobile-runtime.mts` after changing the runtime.

import { writeFile } from 'node:fs/promises'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { build, type Rolldown } from 'vite'

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..')
const entry = path.join(root, 'src/shared/artifact-runtime/runtime.ts')
const out = path.join(root, 'mobile/src/artifact-view/page-runtime.generated.ts')

const built = (await build({
  configFile: false,
  logLevel: 'warn',
  publicDir: false,
  build: {
    write: false,
    minify: true,
    target: 'es2022',
    lib: { entry, formats: ['iife'], name: '__kettuRuntime' },
  },
})) as Rolldown.RolldownOutput | Rolldown.RolldownOutput[]
const code = (Array.isArray(built) ? built[0]! : built).output[0].code
if (/<\/script/i.test(code)) throw new Error('The page runtime holds "</script"')

await writeFile(
  out,
  '// Generated by tools/build/mobile-runtime.mts from src/shared/artifact-runtime/runtime.ts.\n' +
    '// Do not edit; run `node tools/build/mobile-runtime.mts` after changing the runtime.\n' +
    `export default ${JSON.stringify(code)}\n`,
)
console.log(`Wrote ${path.relative(root, out)} (${code.length} characters)`)
